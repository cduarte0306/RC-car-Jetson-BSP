#!/usr/bin/env bash
set -euo pipefail

PARTLABEL="@PARTLABEL@"
FSTYPE="@FSTYPE@"
MOUNTPOINT="@MOUNTPOINT@"
MIN_SIZE_BYTES="@MIN_SIZE_BYTES@"
AUTO_RESIZE="@AUTO_RESIZE@"
MARKER_NAME=".rc-car-data-initialized"

log() { echo "rc-car-data-init: $*"; }

DEV="/dev/disk/by-partlabel/${PARTLABEL}"
if [ ! -e "${DEV}" ]; then
  if command -v lsblk >/dev/null 2>&1; then
    DEV_CANDIDATE="$(lsblk -rpno NAME,PARTLABEL 2>/dev/null | awk -v pl="${PARTLABEL}" '$2==pl {print $1; exit}')"
    if [ -n "${DEV_CANDIDATE}" ] && [ -b "${DEV_CANDIDATE}" ]; then
      DEV="${DEV_CANDIDATE}"
    fi
  fi
fi

if [ ! -e "${DEV}" ]; then
  log "partition not found for PARTLABEL=${PARTLABEL} (skipping)"
  exit 0
fi

get_dev_size_bytes() {
  local d="$1"
  local bytes=""
  if command -v blockdev >/dev/null 2>&1; then
    bytes="$(blockdev --getsize64 "$d" 2>/dev/null || true)"
  fi
  if [ -z "${bytes}" ] && [ -b "$d" ]; then
    local kname
    kname="$(basename "$(readlink -f "$d")")"
    if [ -r "/sys/class/block/${kname}/size" ]; then
      bytes="$(( $(cat "/sys/class/block/${kname}/size") * 512 ))"
    fi
  fi
  echo "${bytes}"
}

human_gib() {
  local bytes="$1"
  awk -v b="$bytes" 'BEGIN { printf "%.1fGiB", b/1024/1024/1024 }'
}

min_bytes_int=0
if [[ "${MIN_SIZE_BYTES}" =~ ^[0-9]+$ ]]; then
  min_bytes_int="${MIN_SIZE_BYTES}"
fi

actual_bytes="$(get_dev_size_bytes "${DEV}")"
size_ok=1
if [ -n "${actual_bytes}" ] && [ "${min_bytes_int}" -gt 0 ]; then
  if [ "${actual_bytes}" -lt "${min_bytes_int}" ]; then
    log "partition ${DEV} is too small: $(human_gib "${actual_bytes}"), expected >= $(human_gib "${min_bytes_int}")"
    size_ok=0
  fi
fi

maybe_resize_partition_live() {
  local dev_real disk partnum start_sector last_usable needed_sectors end_sector

  [ "${AUTO_RESIZE}" = "1" ] || return 0
  [ "${min_bytes_int}" -gt 0 ] || return 0
  [ "${FSTYPE}" = "ext4" ] || return 0

  if ! command -v sgdisk >/dev/null 2>&1; then
    log "AUTO_RESIZE enabled but sgdisk not available"
    return 0
  fi

  dev_real="$(readlink -f "${DEV}" 2>/dev/null || true)"
  if [ -z "${dev_real}" ] || [ ! -b "${dev_real}" ]; then
    log "AUTO_RESIZE enabled but cannot resolve block device for ${DEV}"
    return 0
  fi

  disk="$(lsblk -no PKNAME "${dev_real}" 2>/dev/null || true)"
  partnum="$(lsblk -no PARTNUM "${dev_real}" 2>/dev/null || true)"
  if [ -z "${disk}" ] || [ -z "${partnum}" ]; then
    log "AUTO_RESIZE enabled but cannot determine parent disk/partnum for ${dev_real}"
    return 0
  fi
  disk="/dev/${disk}"

  if mountpoint -q "${MOUNTPOINT}" 2>/dev/null; then
    log "unmounting ${MOUNTPOINT} for partition resize"
    umount "${MOUNTPOINT}"
  fi

  log "relocating backup GPT to end of disk (sgdisk -e ${disk})"
  sgdisk -e "${disk}" >/dev/null 2>&1 || true

  start_sector="$(sgdisk -i "${partnum}" "${disk}" 2>/dev/null | awk -F: '/First sector/ {gsub(/ /,"",$2); print $2; exit}')"
  last_usable="$(sgdisk -E "${disk}" 2>/dev/null | tr -d ' ' | tail -n 1)"
  if ! [[ "${start_sector}" =~ ^[0-9]+$ ]] || ! [[ "${last_usable}" =~ ^[0-9]+$ ]]; then
    log "AUTO_RESIZE enabled but could not read start/last sector from GPT"
    return 0
  fi

  needed_sectors="$(( (min_bytes_int + 511) / 512 ))"
  end_sector="$(( start_sector + needed_sectors - 1 ))"
  if [ "${end_sector}" -gt "${last_usable}" ]; then
    log "not enough space to grow ${PARTLABEL} to requested minimum"
    return 0
  fi

  if sgdisk -i "$((partnum + 1))" "${disk}" >/dev/null 2>&1; then
    local next_label next_dev
    next_dev="${disk}p$((partnum + 1))"
    next_label="$(lsblk -no PARTLABEL "${next_dev}" 2>/dev/null || true)"
    if [ "${next_label}" = "reserved" ] || [ -z "${next_label}" ]; then
      log "deleting adjacent reserved partition $((partnum + 1)) to make room"
      sgdisk -d "$((partnum + 1))" "${disk}" >/dev/null
      last_usable="$(sgdisk -E "${disk}" 2>/dev/null | tr -d ' ' | tail -n 1)"
      if [[ "${last_usable}" =~ ^[0-9]+$ ]] && [ "${end_sector}" -gt "${last_usable}" ]; then
        log "not enough space after deleting reserved partition"
        return 0
      fi
    else
      log "next partition is not 'reserved' (label=${next_label}); refusing to resize automatically"
      return 0
    fi
  fi

  log "updating GPT entry for ${PARTLABEL} to reach >= $(human_gib "${min_bytes_int}")"
  local typecode
  typecode="$(sgdisk -i "${partnum}" "${disk}" 2>/dev/null | awk -F: '/Partition GUID code/ {print $2}' | awk '{print $1; exit}')"
  [ -n "${typecode}" ] || typecode="8300"

  sgdisk -d "${partnum}" "${disk}" >/dev/null
  sgdisk -n "${partnum}:${start_sector}:${end_sector}" -t "${partnum}:${typecode}" -c "${partnum}:${PARTLABEL}" "${disk}" >/dev/null

  if command -v partx >/dev/null 2>&1; then
    partx -u "${disk}" >/dev/null 2>&1 || true
  fi
  if command -v blockdev >/dev/null 2>&1; then
    blockdev --rereadpt "${disk}" >/dev/null 2>&1 || true
  fi
  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle >/dev/null 2>&1 || true
  fi

  if command -v e2fsck >/dev/null 2>&1; then
    e2fsck -pf "${dev_real}" >/dev/null 2>&1 || true
  fi
  if command -v resize2fs >/dev/null 2>&1; then
    resize2fs "${dev_real}" >/dev/null 2>&1 || true
  fi

  mkdir -p "${MOUNTPOINT}"
  mount -t "${FSTYPE}" "${DEV}" "${MOUNTPOINT}" >/dev/null 2>&1 || true
}

mkdir -p "${MOUNTPOINT}"

if command -v mountpoint >/dev/null 2>&1 && mountpoint -q "${MOUNTPOINT}"; then
  exit 0
fi

if [ -e "${MOUNTPOINT}/${MARKER_NAME}" ]; then
  log "marker exists but ${MOUNTPOINT} is not a mount; attempting mount"
fi

fs_type="$(blkid -o value -s TYPE "${DEV}" 2>/dev/null || true)"

if [ -z "${fs_type}" ]; then
  log "no filesystem detected on ${DEV}; formatting as ${FSTYPE} (this wipes existing contents)"
  case "${FSTYPE}" in
    ext4)
      mkfs.ext4 -F -L "${PARTLABEL}" "${DEV}" >/dev/null
      ;;
    *)
      log "unsupported filesystem type: ${FSTYPE} (skipping)"
      exit 0
      ;;
  esac
else
  if [ "${fs_type}" != "${FSTYPE}" ]; then
    log "existing filesystem type on ${DEV} is ${fs_type} (expected ${FSTYPE}); not reformatting"
  fi
fi

if [ "${size_ok}" -eq 0 ]; then
  maybe_resize_partition_live
  actual_bytes="$(get_dev_size_bytes "${DEV}")"
  size_ok=1
  if [ -n "${actual_bytes}" ] && [ "${min_bytes_int}" -gt 0 ]; then
    if [ "${actual_bytes}" -lt "${min_bytes_int}" ]; then
      log "partition ${DEV} is still too small after attempted resize: $(human_gib "${actual_bytes}")"
      size_ok=0
    fi
  fi
fi

if ! grep -qE "^[^#]*[[:space:]]+${MOUNTPOINT}[[:space:]]" /etc/fstab 2>/dev/null; then
  log "adding fstab entry for ${MOUNTPOINT}"
  echo "${DEV}  ${MOUNTPOINT}  ${FSTYPE}  defaults,nofail,x-systemd.device-timeout=10  0  2" >> /etc/fstab
fi

if ! mount "${MOUNTPOINT}" 2>/dev/null; then
  log "fstab mount failed; attempting direct mount"
  mount -t "${FSTYPE}" "${DEV}" "${MOUNTPOINT}"
fi

if [ "${size_ok}" -eq 1 ]; then
  touch "${MOUNTPOINT}/${MARKER_NAME}"
fi
